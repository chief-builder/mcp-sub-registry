# Database Configuration
DATABASE_URL=postgresql://postgres:postgres123@localhost:5435/mcp_registry

# JWT Authentication (CRITICAL: Change in production)
JWT_SECRET=your-secure-jwt-secret-here-minimum-32-characters
JWT_EXPIRES_IN=8h

# Server Configuration
PORT=3010
NODE_ENV=development

# Admin Setup (Optional - for initial admin user creation)
ADMIN_SETUP_KEY=your-admin-setup-key-for-production

# Security Configuration
BCRYPT_ROUNDS=12
MAX_API_KEYS_PER_USER=10

# CORS Configuration (comma-separated origins for production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging Configuration
LOG_LEVEL=info
