# Database Configuration
DATABASE_URL=postgresql://postgres:postgres123@localhost:5435/mcp_registry

# JWT Authentication (REQUIRED: generate a unique value, min 32 chars)
# e.g. `openssl rand -base64 48`. Placeholder/example values are rejected at startup.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Server Configuration
PORT=3010
NODE_ENV=development

# Admin Setup (REQUIRED in production: min 32 chars, used to bootstrap the first
# admin user via POST /api/v1/auth/register). Generate with `openssl rand -base64 48`.
ADMIN_SETUP_KEY=

# Security Configuration
BCRYPT_ROUNDS=12
MAX_API_KEYS_PER_USER=10

# CORS Configuration (comma-separated origins for production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging Configuration
LOG_LEVEL=info
