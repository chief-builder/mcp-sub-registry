{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.deepsec/security-scanner",
  "title": "DeepSec Security Scanner",
  "description": "Runs application security scans and returns prioritized findings for code, dependency, container, and secret exposure reviews.",
  "version": "1.4.2",
  "websiteUrl": "https://security.example.com/deepsec",
  "repository": {
    "url": "https://github.com/example/deepsec-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@deepsec/mcp-security-scanner",
      "version": "1.4.2",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "node",
      "environmentVariables": [
        {
          "name": "DEEPSEC_API_TOKEN",
          "description": "Token used by the MCP server to call the DeepSec scanning API.",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "DEEPSEC_POLICY",
          "description": "Policy profile used for scan thresholds.",
          "default": "enterprise-baseline",
          "choices": ["enterprise-baseline", "strict-release", "audit-only"]
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://security.example.com/mcp/deepsec",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer token for the DeepSec MCP endpoint.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "_meta": {
    "com.example.category": "security",
    "com.example.owner": "product-security",
    "com.example.riskTier": "high",
    "com.example.approvalRequired": true,
    "com.example.supportedFindings": [
      "secrets",
      "dependencies",
      "containers",
      "static-analysis"
    ]
  }
}
